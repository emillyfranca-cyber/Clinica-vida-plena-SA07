* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Seletor de TAG */
body {
    font-family: Arial, Helvetica, sans-serif;
    color: black;
    line-height: 1.6;
}

h1 {
    font-size: 35px;
}

h2 {
    font-size: 24px;
    margin-bottom: 8px;
}

p {
    margin-bottom: 16px;
}

a {
    text-decoration: none;
    color: fuchsia;
}

header {
    background-color: rgb(255, 231, 244);
    color: rgb(255, 30, 116);
    padding: 32px 16px;
    text-align: center;
}

header h1 {
    color:rgb(190, 13, 107);
    letter-spacing: 2px;
    text-transform: uppercase;
}

nav ul {
    list-style: none;
}

nav li {
    display: inline-block;
    margin: 0 16px
}

nav a {
    color: rgb(146, 0, 97);
    font-weight: bold;
}

main {
    max-width: 960px;
    margin: 0 auto;
    padding: 32px 16px
}

footer {
    background-color: rgb(208, 8, 141);
    color: rgb(244, 241, 243);
    text-align: center;
    padding: 24px 16px;
}

/* Seletor de classe */
.card {
    background-color: rgb(255, 241, 250);
    border: 1px solid;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
    text-align: center;
}

.foto {
    background-color: rgb(255, 222, 239);
    background-size: cover;
    background-position: center;
    height: 160px;
    border-radius: 4px;
    margin-bottom: 12px;
}

.pacote {
    padding: 12px;
    border-radius: 4px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 12px;
}

.pacote-essencial {
    background-color: rgb(255, 220, 238);
    border-left: 4px solid #fc2078;

}

.pacote-premium {
    background-color: rgb(255, 242, 251);
    color: #6f475b;
    border-left: 4px solid #6f475a;
}

/* Seletor de ID */
#sobre {
    padding: 24px 0;
}

#portfólio {
    padding: 24px;
}

#pacotes {
    background-color: rgb(245, 245, 245);
    border-radius: 8px;
    padding: 24px;
}

#horario {
    background-color: rgb(243, 243, 243);
    border-radius: 8px;
    padding: 24px;
    margin-top: 24px;
}

#foto-casamento {
    background-image: url("casamento.jp");
}

#foto-corporativo {
    background-image: url("corporativo.jpeg");
}

#foto-newborn {
    background-image: url("Imagem pediatria.png");
}

/* Seletor compartilhado */
h1, h2, h3 {
    font-family: 'Georgia', serif;
    color: 1a1a1a; 
}